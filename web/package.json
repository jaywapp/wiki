{
  "name": "jaywapp-wiki-reader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "dev": "vite --host 127.0.0.1 --port 4318 --strictPort",
    "build": "vite build",
    "build:fresh": "npm run sync && npm run build",
    "package:vercel": "node scripts/package-vercel.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4318 --strictPort",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "5.3.0",
    "dompurify": "3.4.15",
    "highlight.js": "11.12.0",
    "marked": "18.0.12",
    "mermaid": "11.17.2",
    "vite": "6.4.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "jsdom": "29.1.1"
  }
}
